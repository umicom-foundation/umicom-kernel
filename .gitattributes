# Use stable text endings in independent checkouts as well as submodules.
# Git detects other text automatically and leaves binary resources unchanged.
# Adding this policy does not require renormalising existing tracked files.
* text=auto

.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
*.c text eol=lf
*.h text eol=lf
*.inc text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.s text eol=lf
*.S text eol=lf
*.asm text eol=lf
*.ld text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.in text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.umilayout text eol=lf

# Windows command files retain the endings expected by their native tools.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Preserve asset and firmware bytes without line-ending conversion.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.webp -text
*.pdf -text
*.docx -text
*.xlsx -text
*.zip -text
*.7z -text
*.wav -text
*.mp3 -text
*.mp4 -text
*.bin -text
*.elf -text
*.img -text
*.iso -text
*.exe -text
*.dll -text
*.lib -text
*.pdb -text
