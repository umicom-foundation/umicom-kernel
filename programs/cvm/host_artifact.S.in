    .section .rodata.umicom_cvm_host_artifact, "a", @progbits
    .balign 8
    .global UmicomHostCvmArtifactStart
    .global UmicomHostCvmArtifactEnd
UmicomHostCvmArtifactStart:
    .incbin "@UMICOM_KERNEL_CVM_HOST_ARTIFACT_FILE@"
UmicomHostCvmArtifactEnd:
