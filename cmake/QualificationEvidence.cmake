cmake_minimum_required(VERSION 3.24)
foreach(_required SOURCE BINARY MODE)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
if(NOT MODE STREQUAL "capture" AND NOT MODE STREQUAL "verify")
    message(FATAL_ERROR "Evidence mode must be capture or verify")
endif()
if(NOT EXISTS "${SOURCE}/CMakeLists.txt" OR NOT IS_DIRECTORY "${BINARY}")
    message(FATAL_ERROR "A source project and existing build directory are required")
endif()

# Encode values, not CMake source. Neither names nor evidence are executed.
function(JsonQuoted out value)
    string(REPLACE "\\" "\\\\" _escaped "${value}")
    string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
    string(REPLACE "\n" "\\n" _escaped "${_escaped}")
    string(REPLACE "\r" "\\r" _escaped "${_escaped}")
    string(REPLACE "\t" "\\t" _escaped "${_escaped}")
    set(${out} "\"${_escaped}\"" PARENT_SCOPE)
endfunction()

function(Inventory root kind out_json out_hash)
    if(kind STREQUAL "source")
        set(_files CMakeLists.txt)
        if(EXISTS "${root}/CMakePresets.json")
            list(APPEND _files CMakePresets.json)
        endif()
        foreach(_tree arch cmake include kernel platform programs scripts tests tools)
            file(GLOB_RECURSE _tree_files LIST_DIRECTORIES FALSE
                RELATIVE "${root}" "${root}/${_tree}/*")
            list(APPEND _files ${_tree_files})
        endforeach()
        list(FILTER _files EXCLUDE REGEX "(^|/)(build|build-[^/]*|CMakeFiles|\\.git)/")
    else()
        # Recursion also collected disposable test fixtures while parallel
        # checks were changing them. Keep that draft for review; actual linked
        # images occupy these three direct output directories.
        if(FALSE)
        file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${root}"
            "${root}/bin/*.elf" "${root}/tests/*.elf" "${root}/contracts/*.elf")
        endif()
        file(GLOB _files LIST_DIRECTORIES FALSE RELATIVE "${root}"
            "${root}/bin/*.elf" "${root}/tests/*.elf" "${root}/contracts/*.elf")
    endif()
    list(REMOVE_DUPLICATES _files)
    list(SORT _files)
    if(NOT _files)
        message(FATAL_ERROR "No ${kind} files are available to identify")
    endif()
    set(_json "{}")
    set(_canonical "")
    foreach(_file IN LISTS _files)
        if(IS_SYMLINK "${root}/${_file}")
            message(FATAL_ERROR "Evidence requires ordinary files: ${_file}")
        endif()
        if(_file MATCHES "[\r\n\t]")
            message(FATAL_ERROR "Control characters in evidence file name")
        endif()
        file(SHA256 "${root}/${_file}" _hash)
        JsonQuoted(_value "${_hash}")
        string(JSON _json SET "${_json}" "${_file}" "${_value}")
        string(APPEND _canonical "${_hash}\t${_file}\n")
    endforeach()
    string(SHA256 _digest "${_canonical}")
    set(${out_json} "${_json}" PARENT_SCOPE)
    set(${out_hash} "${_digest}" PARENT_SCOPE)
endfunction()

Inventory("${SOURCE}" source _sources _source_hash)
Inventory("${BINARY}" images _images _image_hash)
set(_output "${BINARY}/qualification/identity.json")
if(MODE STREQUAL "verify")
    if(NOT EXISTS "${_output}")
        message(FATAL_ERROR "Build umicom-kernel-evidence before checking identity")
    endif()
    file(SIZE "${_output}" _size)
    if(_size GREATER 16777216)
        message(FATAL_ERROR "Evidence exceeds the inspection limit")
    endif()
    file(READ "${_output}" _saved)
    string(JSON _schema GET "${_saved}" schema)
    string(JSON _version GET "${_saved}" version)
    string(JSON _before_source GET "${_saved}" sourceSha256)
    string(JSON _before_images GET "${_saved}" imagesSha256)
    string(JSON _before_files GET "${_saved}" sources)
    string(JSON _before_artifacts GET "${_saved}" images)
    if(NOT _schema STREQUAL "umicom.kernel.build-identity" OR NOT _version EQUAL 1 OR
       NOT _before_source STREQUAL _source_hash OR NOT _before_images STREQUAL _image_hash OR
       NOT _before_files STREQUAL _sources OR NOT _before_artifacts STREQUAL _images)
        message(FATAL_ERROR "Source or ELF identity differs from captured build evidence; rebuild before qualification")
    endif()
    message(STATUS "Kernel source and ELF identities agree: ${_source_hash}")
    return()
endif()

set(_json "{}")
JsonQuoted(_value "umicom.kernel.build-identity")
string(JSON _json SET "${_json}" schema "${_value}")
string(JSON _json SET "${_json}" version 1)
JsonQuoted(_value "${_source_hash}")
string(JSON _json SET "${_json}" sourceSha256 "${_value}")
JsonQuoted(_value "${_image_hash}")
string(JSON _json SET "${_json}" imagesSha256 "${_value}")
string(JSON _json SET "${_json}" sources "${_sources}")
string(JSON _json SET "${_json}" images "${_images}")
foreach(_field COMPILER COMPILER_ID COMPILER_VERSION ARCHITECTURE ABI MACHINE QEMU)
    if(NOT DEFINED ${_field})
        set(${_field} "not-supplied")
    endif()
    JsonQuoted(_value "${${_field}}")
    string(JSON _json SET "${_json}" "${_field}" "${_value}")
endforeach()
# A commit identifies the recorded repository state, while source hashes also
# cover unpublished files. Never treat a clean-looking commit label as the
# identity of a dirty working tree. Tarball builds may have no Git metadata.
set(_revision "unavailable")
set(_tracked_changes null)
find_program(_git NAMES git)
if(_git)
    execute_process(COMMAND "${_git}" -C "${SOURCE}" rev-parse HEAD
        RESULT_VARIABLE _git_result OUTPUT_VARIABLE _head ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 10)
    string(LENGTH "${_head}" _head_length)
    if(_git_result STREQUAL "0" AND _head MATCHES "^[0-9a-f]+$" AND
       (_head_length EQUAL 40 OR _head_length EQUAL 64))
        set(_revision "${_head}")
        execute_process(COMMAND "${_git}" --no-optional-locks -C "${SOURCE}"
            status --porcelain --untracked-files=no
            RESULT_VARIABLE _status_result OUTPUT_VARIABLE _status ERROR_QUIET TIMEOUT 10)
        if(_status_result STREQUAL "0")
            if(_status STREQUAL "")
                set(_tracked_changes false)
            else()
                set(_tracked_changes true)
            endif()
        endif()
    endif()
endif()
JsonQuoted(_value "${_revision}")
string(JSON _json SET "${_json}" gitHead "${_value}")
string(JSON _json SET "${_json}" trackedChanges ${_tracked_changes})
set(_qemu_version "unavailable")
if(EXISTS "${QEMU}")
    execute_process(COMMAND "${QEMU}" --version RESULT_VARIABLE _qemu_result
        OUTPUT_VARIABLE _qemu_text ERROR_QUIET TIMEOUT 10)
    if(_qemu_result STREQUAL "0")
        string(REGEX MATCH "^[^\r\n]+" _qemu_version "${_qemu_text}")
    endif()
endif()
JsonQuoted(_value "${_qemu_version}")
string(JSON _json SET "${_json}" qemuVersion "${_value}")
string(JSON _json SET "${_json}" sourceStableDuringBuildVerified false)
string(JSON _json SET "${_json}" runtimePassed false)
file(MAKE_DIRECTORY "${BINARY}/qualification")
# Publish only after capture succeeds. The source checkout is never written.
file(WRITE "${_output}.tmp" "${_json}\n")
file(RENAME "${_output}.tmp" "${_output}" RESULT _rename)
if(NOT _rename STREQUAL "0")
    message(FATAL_ERROR "Cannot publish build evidence: ${_rename}")
endif()
message(STATUS "Kernel build identity captured: ${_output}")
