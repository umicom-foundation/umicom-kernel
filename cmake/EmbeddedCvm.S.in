UmicomEmbeddedCvmO0End:
    .balign 16
    .global UmicomEmbeddedCvmO2Start
    .global UmicomEmbeddedCvmO2End
UmicomEmbeddedCvmO2Start:
    .incbin "@UMICOM_CVM_O2_FILE@"
UmicomEmbeddedCvmO2End:
