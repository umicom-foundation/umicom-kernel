#-----------------------------------------------------------------------------
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED WORK OR NOT DEFINED CASE OR NOT DEFINED EVIDENCE)
    message(FATAL_ERROR "Work, case and evidence script are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _token)
set(_source "${WORK}/${_token}/source with spaces")
set(_binary "${WORK}/${_token}/build with spaces")
file(MAKE_DIRECTORY "${_source}/kernel" "${_binary}/bin")
file(WRITE "${_source}/CMakeLists.txt" "# fixture\n")
file(WRITE "${_source}/kernel/main.c" "void boot(void) {}\n")
# Hashing does not parse or execute ELF. Synthetic bytes keep the fixture inert.
file(WRITE "${_binary}/bin/umicom-kernel.elf" "synthetic-image-not-executable")
function(Run mode expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${_source}" "-DBINARY=${_binary}"
        "-DMODE=${mode}" -P "${EVIDENCE}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 15)
    if(expected STREQUAL "success")
        if(NOT _result STREQUAL "0")
            message(FATAL_ERROR "Expected accepted evidence: ${_result}\n${_out}\n${_err}")
        endif()
    elseif(_result STREQUAL "0")
        message(FATAL_ERROR "Changed or invalid evidence was accepted")
    endif()
endfunction()
Run(capture success)
set(_record "${_binary}/qualification/identity.json")
file(READ "${_record}" _json)
string(JSON _runtime GET "${_json}" runtimePassed)
string(JSON _stable GET "${_json}" sourceStableDuringBuildVerified)
string(JSON _count LENGTH "${_json}" sources)
if(_runtime OR _stable OR NOT _count EQUAL 2)
    message(FATAL_ERROR "Capture must not invent runtime or source-stability proof")
endif()
set(_expected failure)
if(CASE STREQUAL "unchanged")
    set(_expected success)
elseif(CASE STREQUAL "unrelated-fixture")
    file(MAKE_DIRECTORY "${_binary}/tests/fixtures/nested")
    file(WRITE "${_binary}/tests/fixtures/nested/inert.elf" "unrelated test evidence")
    set(_expected success)
elseif(CASE STREQUAL "source-edit")
    file(APPEND "${_source}/kernel/main.c" "/* changed */\n")
elseif(CASE STREQUAL "source-added")
    file(WRITE "${_source}/kernel/new.c" "void added(void) {}\n")
elseif(CASE STREQUAL "source-removed")
    file(RENAME "${_source}/kernel/main.c" "${WORK}/${_token}/saved-main.c")
elseif(CASE STREQUAL "image-edit")
    file(APPEND "${_binary}/bin/umicom-kernel.elf" "changed")
elseif(CASE STREQUAL "image-added")
    file(WRITE "${_binary}/bin/umicom-system.elf" "another-inert-fixture")
elseif(CASE STREQUAL "image-missing" OR CASE STREQUAL "missing-images")
    file(RENAME "${_binary}/bin/umicom-kernel.elf" "${WORK}/${_token}/saved-image")
elseif(CASE STREQUAL "corrupt-evidence")
    file(WRITE "${_record}" "{broken json")
elseif(NOT CASE STREQUAL "unknown-mode")
    message(FATAL_ERROR "Unknown evidence fixture")
endif()
file(SHA256 "${_record}" _before)
if(CASE STREQUAL "missing-images")
    Run(capture failure)
elseif(CASE STREQUAL "unknown-mode")
    Run(other failure)
else()
    Run(verify "${_expected}")
endif()
file(SHA256 "${_record}" _after)
if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Inspection or rejected capture changed existing evidence")
endif()
